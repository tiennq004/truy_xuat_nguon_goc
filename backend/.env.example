PORT=4000
# URL gắn trong QR (production = domain Vercel):
# FRONTEND_VERIFY_BASE=https://your-app.vercel.app/verify
FRONTEND_VERIFY_BASE=http://localhost:5173/verify

# Cho phep frontend goi API (production):
# CORS_ORIGIN=https://your-app.vercel.app

# Optional Firebase mode. If empty, backend uses memory storage.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
ENABLE_FIREBASE_STORAGE=false

# Optional Ethereum mode. If empty, backend uses memory blockchain.
RPC_URL=http://127.0.0.1:8545
WALLET_PRIVATE_KEY=
CONTRACT_ADDRESS=
# Option A: put ABI JSON directly (one line)
CONTRACT_ABI=
# Option B (recommended): point to Hardhat artifact file
CONTRACT_ABI_FILE=../blockchain/artifacts/contracts/PharmaTrace.sol/PharmaTrace.json
